---
// a button that re-drives the Prototype to `goto`, or to its chapter's when it has none.
interface Props { goto?: Record<string, unknown>; icon?: string }
const { goto, icon = 'hand-finger' } = Astro.props;
---
<button class="try" data-goto={goto && JSON.stringify(goto)}><i class={`ti ti-${icon}`}></i> <slot /></button>
