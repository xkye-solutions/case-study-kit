---
// a "key flow" chapter rendered from a flows-collection entry: its frontmatter is the chapter (see schema.ts), and
// its MDX body is free, with the kit's blocks available without importing them.
import Chapter from './Chapter.astro';
import BeforeAfter from './BeforeAfter.astro';
import Decisions from './Decisions.astro';
import Tries from './Tries.astro';
import TryButton from './TryButton.astro';
import { render } from 'astro:content';
const { entry } = Astro.props;
const f = entry.data;
const { Content } = await render(entry);
---
<Chapter num={f.num} goto={f.goto}>
  <div class="flow-head"><div class="ic"><i class={`ti ti-${f.icon}`}></i></div><h2 style="margin:0">{f.title}</h2></div>
  <div class="flow-body"><Content components={{ BeforeAfter, Decisions, Tries, TryButton }} /></div>
</Chapter>
<style>
  .flow-body :global(> p:first-child) { margin-top: 18px; }
</style>
