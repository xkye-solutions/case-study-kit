---
// one scroll-synced chapter. `goto` is where the Prototype goes while it's in view.
interface Props { id?: string; num?: string; goto: Record<string, unknown> }
const { id, num, goto } = Astro.props;
---
<section class="chapter" id={id} data-goto={JSON.stringify(goto)}>
  {num && <div class="num">{num}</div>}
  <slot />
</section>
